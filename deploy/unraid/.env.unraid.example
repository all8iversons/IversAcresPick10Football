# Copy to .env.unraid in the protected deployment directory.
# Keep secrets in the official Supabase docker/.env file; do not commit populated files.

APP_SOURCE_PATH=/mnt/user/appdata/ivers-acres-pick10/source
SUPABASE_DOCKER_DIR=/mnt/user/appdata/ivers-acres-pick10/supabase/docker
DEPLOYMENT_DIR=/mnt/user/appdata/ivers-acres-pick10/deployment
SUPABASE_POSTGRES_DATA_PATH=/mnt/user/appdata/ivers-acres-pick10/supabase/docker/volumes/db/data
SUPABASE_STORAGE_PATH=/mnt/user/appdata/ivers-acres-pick10/supabase/docker/volumes/storage
BACKUP_DIR=/mnt/user/backups/ivers-acres-pick10

# Use an immutable release tag and the exact supported Supabase source release.
APP_IMAGE=ivers-acres-pick10:0.1.0
SUPABASE_RELEASE=v1.26.08
SUPABASE_CLI_VERSION=2.122.0

# Set these public origins to addresses reachable from participant devices.
SITE_URL=http://unraid-host:3000
SUPABASE_PUBLIC_URL=http://unraid-host:8000
API_EXTERNAL_URL=http://unraid-host:8000
ADDITIONAL_REDIRECT_URLS=http://unraid-host:3000/auth/callback
SUPABASE_INTERNAL_URL=http://api-gw:8000

APP_BIND_IP=0.0.0.0
APP_PORT=3000
GATEWAY_BIND_IP=0.0.0.0
KONG_HTTP_PORT=8000
